language = "English",
volume = "81",
pages = "127--132",
journal = "Information Processing Letters",
issn = "0020-0190",
publisher = "Elsevier B.V.",
number = "3",

}


@article{jacodesmath23codesGF17,
title = "New results and bounds on codes over GF (17)",
abstract = "Determining the best possible values of the parameters of a linear code is one of the most fundamental and challenging problems in coding theory. There exist databases of best-known linear codes (BKLC) over small finite fields. In this work, we establish a database of BKLCs over the field GF (17) together with upper bounds on the minimum distances for lengths up to 150 and dimensions up to 6. In the process, we have found many new linear codes over GF (17).",
keywords = "Distance bounds, Lower bounds, Optimal codes, Quasi-cyclic codes, Quasi-twisted codes, Search algorithms for linear codes, Upper bounds",
author = "Eric Chen and Nuh Aydin and Fredrik J{\"o}nsson and Kamilla Klonowska",
year = "2023",
month = oct,
day = "23",
doi = "10.13069/jacodesmath.v11i1.257",
language = "English",
volume = "11",
pages = "27--39",
journal = "Journal of Algebra Combinatorics Discrete Structures and Applications",
issn = "2148-838X",
publisher = "Jacodesmath Institute",
number = "1",

}


@article{jacodesmath23qccodes,
title = "New good quasi-cyclic codes and codes with improved minimum distance",
abstract = "One of the most important and challenging problems in coding theory is to construct codes with optimal parameters. As a generalization of cyclic codes, quasi-cyclic (QC) codes as well as quasi-twisted (QT) codes have been shown to contain record-breaking codes. In this paper, various computer algorithms have been used to search for good QC codes. A lot of good new QC codes have been found and they have been used to construct new linear codes. A total 11 new codes that improve the bound on the minimum distance are presented.",
keywords = "Finite fields, Linear codes, Quasi-cyclic codes, Algorithms",
author = "Eric Chen and Fredrik J{\"o}nsson",
year = "2023",
month = jan,
day = "4",
language = "English",
volume = "10",
pages = "39--44",
journal = "Journal of Algebra Combinatorics Discrete Structures and Applications",
issn = "2148-838X",
publisher = "Jacodesmath Institute",
number = "1",

}


