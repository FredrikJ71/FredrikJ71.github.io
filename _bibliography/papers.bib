@article{ieeeit02analysisconvcode,
title = "Theoretical analysis of a correlation attack based on convolutional codes",
abstract = "One general class of attacks on stream ciphers is correlation attacks. Most of previous results regarding performance of correlation attacks have been based entirely on simulations. In this paper, we use random coding bounds for convolutional codes to give a theoretical analysis of a previously proposed correlation attack based on convolutional codes. The results from the theoretical derivation are verified by simulations.",
keywords = "Convolutional codes, Correlation attacks, Crypt-analysis, Nonlinear combination generator, Stream ciphers",
author = "Thomas Johansson and Fredrik J{\"o}nsson",
note = "Funding Information: Manuscript received November 5, 2001; revised April 2, 2002. This work was supported by the Foundation for Strategic Research–PCC under Grant 9706-09. The material in this paper was presented in part at the IEEE International Symposium on Information Theory, Sorrento, Italy, 2000. The authors are with the Department of Information Technology, Lund University, 221 00 Lund, Sweden (e-mail: thomas@it.lth.se; fredrikj@it.lth.se). Communicated by N. I. Koblitz, Associate Editor for Complexity and Cryptography. Publisher Item Identifier 10.1109/TIT.2002.800494.",
year = "2002",
month = aug,
doi = "10.1109/TIT.2002.800494",
language = "English",
volume = "48",
pages = "2173--2181",
journal = "IEEE Transactions on Information Theory",
issn = "0018-9448",
publisher = "Institute of Electrical and Electronics Engineers Inc.",
number = "8",

}


@article{ieeeit02complexitygeneraldecoding,
title = "On the complexity of some cryptographic problems based on the general decoding problem",
abstract = "A new probabilistic algorithm for decoding one received word from a set of many given received words, into a codeword such that the Hamming distance between the received word and the codeword is at most t, is proposed. The new algorithm is applicable to several cryptographic problems, such as the Stern identification scheme, the McEliece public-key cryptosystem, and in correlation attacks on stream ciphers. When applicable, it runs significantly faster than previous algorithms used for attacks on these cryptosystems.",
keywords = "Complexity, Correlation attack, Decoding algorithms, McEliece cryptosystem, Stern identification scheme",
author = "Thomas Johansson and Fredrik J{\"o}nsson",
note = "Funding Information: Manuscript received February 8, 2001; revised May 24, 2001. This work was supported by the Foundation for Strategic Research–PCC under Grant 9706-09. The material in this paper was presented in part at the IEEE International Symposium on Information Theory, MIT, Cambridge, MA, August 1998.",
year = "2002",
month = oct,
doi = "10.1109/TIT.2002.802608",
language = "English",
volume = "48",
pages = "2669--2678",
journal = "IEEE Transactions on Information Theory",
issn = "0018-9448",
publisher = "Institute of Electrical and Electronics Engineers Inc.",
number = "10",

}


@article{ipllili128,
title = "A fast correlation attack on LILI-128",
abstract = "In this paper we demonstrate a fast correlation attack on the recently proposed stream cipher LILI-128. The attack has complexity around 271 bit operations assuming a received sequence of length around 230 bits and a precomputation phase of complexity 279 table lookups. This complexity is significantly lower than 2112, which was conjectured by the inventors of LILI-128 to be a lower bound on the complexity of any attack.",
keywords = "Cryptography, Fast correlation attack, LILI-128 keystream generator, Stream cipher",
author = "Fredrik J{\"o}nsson and Thomas Johansson",
year = "2002",
month = feb,
