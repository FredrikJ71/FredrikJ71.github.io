@conference{isit2000analysisconvcodes,
title = "Theoretical analysis of a correlation attack based on convolutional codes",
abstract = "Consider a binary synchronous stream cipher where a correlation has been identified between the keystream sequence and the output from one of the LFSRs. Hence, a correlation attack can be applied. By using an estimate from the Viterbi algorithm, the corresponding estimate of the initial state of the LFSR is derived.",
author = "F. J{\"o}nsson and T. Johansson",
year = "2000",
language = "English",
pages = "212",
note = "2000 IEEE International Symposium on Information Theory ; Conference date: 25-06-2000 Through 30-06-2000",

}


@inbook{crypto2000reconstructionlinearpolynomials,
title = "Fast correlation attacks through reconstruction of linear polynomials",
abstract = "The task of a fast correlation attack is to efficiently restore the initial content of a linear feedback shift register in a stream cipher using a detected correlation with the output sequence. We show that by modeling this problem as the problem of learning a binary linear multivariate polynomial, algorithms for polynomial reconstruction with queries can be modified through some general techniques used in fast correlation attacks. The result is a new and efficient way of performing fast correlation attacks.",
keywords = "Correlation attacks, Learning theory, Reconstruction of polynomials, Stream ciphers",
author = "Thomas Johansson and Fredrik J{\"o}nsson",
note = "Publisher Copyright: {\textcopyright} Springer-Verlag Berlin Heidelberg 2000.; 20th Annual International Cryptology Conference, CRYPTO 2000 ; Conference date: 20-08-2000 Through 24-08-2000",
year = "2000",
doi = "10.1007/3-540-44598-6\_19",
language = "English",
isbn = "978-3-540-44598-2",
series = "Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)",
publisher = "Springer Verlag",
pages = "300--315",
editor = "Mihir Bellare",
booktitle = "Advances in Cryptology - CRYPTO 2000",
address = "Germany",

}


